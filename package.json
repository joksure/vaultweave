{
  "name": "vaultweave",
  "version": "1.1.0",
  "description": "Back up Notion to portable Markdown, CSV, JSON and assets, with Git history, watch mode, alerts and S3 targets.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vaultweave": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "CAPABILITIES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joksure/vaultweave.git"
  },
  "bugs": {
    "url": "https://github.com/joksure/vaultweave/issues"
  },
  "homepage": "https://github.com/joksure/vaultweave#readme",
  "keywords": [
    "notion",
    "backup",
    "export",
    "markdown",
    "git",
    "cli",
    "sync",
    "portable",
    "vaultweave"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capabilities": "tsx scripts/gen-capabilities.ts",
    "capabilities:check": "tsx scripts/gen-capabilities.ts --check",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "better-sqlite3": "^11.9.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "msw": "^2.15.0",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "nodemailer": "^10.0.10"
  }
}
